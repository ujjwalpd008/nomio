// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Seed script configuration

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  password      String
  name          String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  nomineesCreated    Nominee[]        @relation("CreatedBy") // Nominees created by this user
  nomineeRecords     Nominee[]        @relation("NomineeUser") // Nominee records linked to this user
  accounts            Account[]
  documents           Document[]
  trustedContacts     TrustedContact[]
  emergencyRequests   EmergencyRequest[]
  auditLogs           AuditLog[]
  nomineeAccess       NomineeAccess[]
  accountsAsNominee   AccountNominee[] // Accounts where this user is nominated
  sentNudges          Nudge[]          @relation("SentNudges")
  receivedNudges      Nudge[]          @relation("ReceivedNudges")

  @@map("users")
}

model Nominee {
  id                    String   @id @default(cuid())
  nominatedByUserId     String   // User who created this nominee record
  userId                String?  // User account if nominee has signed up (matched by email/phone)
  fullName              String
  relationship          String
  email                 String?
  phone                 String
  dateOfBirth           DateTime?
  panNumber             String?
  address               String?
  notificationChannels   String[] @default([]) // Array of channels: Email, WhatsApp
  notificationFrequency String?  // Quarterly, HalfYearly, Annually
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  nominatedBy     User              @relation("CreatedBy", fields: [nominatedByUserId], references: [id], onDelete: Cascade)
  user            User?             @relation("NomineeUser", fields: [userId], references: [id], onDelete: SetNull)
  accountNominees AccountNominee[]
  nomineeAccess   NomineeAccess[]
  nudges          Nudge[]

  @@map("nominees")
}

model Account {
  id            String   @id @default(cuid())
  userId        String
  accountType   String
  institutionName String
  accountNumber String
  approximateValue Float?
  status        String   @default("Active")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNominees AccountNominee[]
  documents       Document[]

  @@map("accounts")
}

model AccountNominee {
  id            String   @id @default(cuid())
  accountId     String
  nomineeId     String?  // Nominee record (for people not yet signed up)
  userId        String?  // User account (for people who have signed up)
  allocationPercentage Float

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nominee Nominee? @relation(fields: [nomineeId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, nomineeId])
  @@unique([accountId, userId])
  @@map("account_nominees")
}

model Document {
  id              String   @id @default(cuid())
  userId          String
  accountId       String?
  title           String
  description     String?
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String
  isCritical      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("documents")
}

model TrustedContact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyRequests EmergencyRequest[]

  @@map("trusted_contacts")
}

model EmergencyRequest {
  id                String   @id @default(cuid())
  userId            String
  trustedContactId  String?
  status            String   @default("Pending")
  deathCertificatePath String?
  idProofPath      String?
  requestedAt       DateTime @default(now())
  reviewedAt        DateTime?
  grantedAt         DateTime?
  reviewedBy        String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustedContact TrustedContact? @relation(fields: [trustedContactId], references: [id], onDelete: SetNull)

  @@map("emergency_requests")
}

model NomineeAccess {
  id            String   @id @default(cuid())
  userId        String
  nomineeId     String?
  emergencyRequestId String?
  accessGrantedAt DateTime @default(now())
  lastAccessedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nominee Nominee? @relation(fields: [nomineeId], references: [id], onDelete: Cascade)

  @@map("nominee_access")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entityType String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Nudge {
  id            String   @id @default(cuid())
  fromUserId    String   // Account holder who sent the nudge
  toUserId      String?  // User account if nominee has signed up
  toNomineeId   String?  // Nominee record if not yet signed up
  message       String   // Custom message from account holder
  status        String   @default("Unread") // Unread, Read, Dismissed
  createdAt     DateTime @default(now())
  readAt        DateTime?

  fromUser    User     @relation("SentNudges", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User?    @relation("ReceivedNudges", fields: [toUserId], references: [id], onDelete: Cascade)
  toNominee   Nominee? @relation(fields: [toNomineeId], references: [id], onDelete: Cascade)

  @@map("nudges")
}
